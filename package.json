{
  "name": "dsh-maze",
  "version": "0.0.1",
  "description": "西部世界风接待员（多主机名册·随机觉醒）：常驻桌面伙伴，镜像会话神态并低语，支持 cron 与模型调用条件提醒、应用外观个性化",
  "license": "MIT",
  "author": "charviki",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charviki/dsh-maze.git"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "assistant",
    "host",
    "reminder"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "assets",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test lib/reminders/engine.test.js lib/reminders/cron.test.js lib/reminders/store.test.js lib/reminders/validate.test.js lib/appearance.test.js lib/narrative.test.js lib/index.test.js",
    "prepack": "npm run build"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.0"
  }
}